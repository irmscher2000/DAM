<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/preguntas"
    android:background="@color/gris_fondo">

    <TextView
        android:id="@+id/titulo_preguntas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/roboto_bold"
        android:text="PÁGINA DE PREGUNTAS"
        android:textAlignment="center"
        android:textColor="@color/negro_texto"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:src="@mipmap/preguntas"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titulo_preguntas"
        app:layout_constraintWidth_percent="0.9" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/pregunta1"
        style="@style/BotónPrincipal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:text="Pregunta 1"
        app:layout_constraintEnd_toStartOf="@id/pregunta2"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageView" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/pregunta2"
        style="@style/BotónPrincipal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pregunta 2"
        app:layout_constraintBaseline_toBaselineOf="@id/pregunta1"
        app:layout_constraintEnd_toStartOf="@id/pregunta3"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@id/pregunta1" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/pregunta3"
        style="@style/BotónPrincipal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pregunta 3"
        app:layout_constraintBaseline_toBaselineOf="@id/pregunta1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@id/pregunta2" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/volver"
        style="@style/BotónPrincipal"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="Volver"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pregunta2" />

</androidx.constraintlayout.widget.ConstraintLayout>