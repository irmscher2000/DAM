<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PMDM03_Tarea_Moga">

        <!-- Actividad principal (login) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Actividad de Instrucciones -->
        <activity
            android:name=".InstruccionesActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity">
            <!-- Esto permite que aparezca la flecha de retroceso en la barra de acción -->
        </activity>

        <activity
            android:name=".PreguntasActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity">
        </activity>

        <activity
            android:name=".Pregunta1Activity"
            android:exported="false"
            android:parentActivityName=".PreguntasActivity">
        </activity>

        <activity
            android:name=".Pregunta2Activity"
            android:exported="false"
            android:parentActivityName=".PreguntasActivity">
        </activity>

        <activity
            android:name=".Pregunta3Activity"
            android:exported="false"
            android:parentActivityName=".PreguntasActivity">
        </activity>

        <activity android:name=".ResultadoActivity"
            android:exported="false"
            android:parentActivityName=".PreguntasActivity">
        </activity>

        <activity android:name=".DAO_BD_Activity"
            android:exported="false"
            android:parentActivityName=".MainActivity">
        </activity>

        <activity android:name=".DetalleActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity">
        </activity>


        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>