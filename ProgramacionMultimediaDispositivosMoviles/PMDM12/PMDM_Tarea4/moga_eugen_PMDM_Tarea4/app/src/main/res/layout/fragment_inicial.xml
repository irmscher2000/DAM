<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/FragmentoInicio"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FragmentInicial">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/img_anchoas"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:cropToPadding="true"
            android:scaleType="centerCrop"
            android:src="@drawable/anchoas" />

        <ImageView
            android:id="@+id/img_chipirones"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:cropToPadding="true"
            android:scaleType="centerCrop"
            android:src="@drawable/chipirones" />

        <ImageView
            android:id="@+id/img_solomillo"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:cropToPadding="true"
            android:scaleType="centerCrop"
            android:src="@drawable/solomillo" />
    </LinearLayout>
</FrameLayout>