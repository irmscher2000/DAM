<Window x:Class="GestionEmpleados2026.ModificarEmpleadoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestionEmpleados2026"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Title="ModificarEmpleadoWindow" Height="800" Width="1024">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Modificar Empleado"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,50,0,30"/>

        <!-- Nombre -->
        <TextBlock Grid.Row="1" 
                   Text="Nombre:" 
                   FontWeight="Bold"
                   Margin="0,10"/>
        <TextBox x:Name="txtNombre"
                 Grid.Row="2"
                 Height="35"
                 Margin="0,0,0,15"
                 VerticalContentAlignment="Center"/>

        <!-- Apellidos -->
        <TextBlock Grid.Row="3" 
                   Text="Apellidos:" 
                   FontWeight="Bold"
                   Margin="0,10"/>
        <TextBox x:Name="txtApellidos"
                 Grid.Row="4"
                 Height="35"
                 Margin="0,0,0,15"
                 VerticalContentAlignment="Center"/>

        <!-- Edad -->
        <TextBlock Grid.Row="5" 
                   Text="Edad:" 
                   FontWeight="Bold"
                   Margin="0,10"/>
        <TextBox x:Name="txtEdad"
                 Grid.Row="6"
                 Height="35"
                 Margin="0,0,0,15"
                 VerticalContentAlignment="Center"/>

        <!-- EsUsuario -->
        <TextBlock Grid.Row="7" 
                   Text="Es Usuario:" 
                   FontWeight="Bold"
                   Margin="0,10"/>
        <CheckBox x:Name="chkEsUsuario"
                  Grid.Row="8"
                  Height="35"
                  Margin="0,0,0,15"
                  VerticalAlignment="Center"/>

        <!-- Botones -->
        <StackPanel Grid.Row="9"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,20">

            <Button x:Name="btnGuardar"
                    Width="120"
                    Height="40"
                    Margin="10"
                    Content="Guardar"
                    Background="#4CAF50"
                    Foreground="White"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="btnGuardar_Click"/>

            <Button x:Name="btnCancelar"
                    Width="120"
                    Height="40"
                    Margin="10"
                    Content="Cancelar"
                    Background="#F44336"
                    Foreground="White"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="btnCancelar_Click"/>
        </StackPanel>




    </Grid>
</Window>
