<Window x:Class="GestionEmpleados2026.BuscarEmpleado"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestionEmpleados2026"
        mc:Ignorable="d"
        Title="BuscarEmpleado" Height="800" Width="1024"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Text="Buscar Empleado"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,50,0,30"/>

        <!-- Panel de búsqueda -->
        <Border Grid.Row="1"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Campo de búsqueda -->
                <TextBlock Text="Buscar por:"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            FontWeight="Bold"
                            FontSize="14"/>

                <ComboBox x:Name="cmbCampoBusqueda"
                                  Grid.Column="1"
                                  Width="150"
                                  Height="35"
                                  Margin="0,0,10,0"
                                  HorizontalAlignment="Left"
                                  SelectedIndex="0">
                    
                    <ComboBoxItem Content="Nombre"/>
                    <ComboBoxItem Content="Apellidos"/>
                    <ComboBoxItem Content="Edad"/>
                    <ComboBoxItem Content="EsUsuario"/>
                </ComboBox>
                
                <!-- Texto de búsqueda -->
                <TextBox x:Name="txtValorBusqueda"
                         Grid.Row="1"
                         Grid.Column="1"
                         Width="300"
                         Height="35"
                         Margin="0,10,10,0"
                         HorizontalAlignment="Left"
                         VerticalContentAlignment="Center"/>

                <!-- Botón Buscar -->
                <Button x:Name="btnBuscar"
                        Grid.Column="2"
                        Grid.RowSpan="2"
                        Width="100"
                        Height="40"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Content="Buscar"
                        Background="#4CAF50"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="btnBuscar_Click"/>
            </Grid>
        </Border>

        <!-- Resultados -->
        <TextBlock Grid.Row="2"
                   Text="RESULTADOS DE LA BÚSQUEDA"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- DataGrid para mostrar resultados -->
        <DataGrid x:Name="dgResultados"
                  Grid.Row="3"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  Margin="0,10,0,10"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  RowHeaderWidth="0"
                  HorizontalAlignment="Stretch">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Height" Value="35"/>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- Panel de botones de acción -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20">

            <Button x:Name="btnModificar"
                    Width="120"
                    Height="40"
                    Margin="10"
                    Content="Modificar"
                    Background="#2196F3"
                    Foreground="White"
                    FontWeight="Bold"
                    Cursor="Hand"
                    IsEnabled="False"
                    Click="btnModificar_Click"/>

            <Button x:Name="btnCerrar"
                    Width="100"
                    Height="40"
                    Margin="10"
                    Content="Cerrar"
                    Background="#F44336"
                    Foreground="White"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="btnCerrar_Click"/>
        </StackPanel>

        <!-- Mensaje de sin resultados -->
        <TextBlock x:Name="txtMensaje"
                   Grid.Row="3"
                   Text="No se encontraron empleados"
                   FontSize="14"
                   FontStyle="Italic"
                   Foreground="Red"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>



    </Grid>
</Window>
